    {
      "name": "1. Authentication & Account Lifecycle",
      "item": [
        {
          "name": "Admin Login (Store adminAccessToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Exact Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Stores adminAccessToken', function () {",
                  "    pm.expect(jsonData.accessToken).to.be.a('string');",
                  "    pm.collectionVariables.set('adminAccessToken', jsonData.accessToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Customer Login (Store customerAccessToken & firstRefreshToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Exact Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Stores customerAccessToken', function () {",
                  "    pm.expect(jsonData.accessToken).to.be.a('string');",
                  "    pm.collectionVariables.set('customerAccessToken', jsonData.accessToken);",
                  "});",
                  "var cookieHeader = pm.response.headers.get('Set-Cookie');",
                  "if (cookieHeader) {",
                  "    var match = cookieHeader.match(/techhub_refresh=([^;]+)/);",
                  "    if (match) { pm.collectionVariables.set('firstRefreshToken', match[1]); }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
